PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Enable to proxy weather straight to Open-Meteo instead of serving offline seed data
WEATHER_PROXY=true
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
DEFAULT_FARM_LAT=20.435
DEFAULT_FARM_LON=77.091

# --- Crop disease AI (server-side only, never exposed to the browser) ---
# Any OpenAI-compatible vision endpoint. Leave AI_API_KEY empty to keep the
# prototype on the bundled sample results.
#   OpenAI       AI_BASE_URL=https://api.openai.com/v1                  AI_MODEL=gpt-4o-mini
#   Groq         AI_BASE_URL=https://api.open-groq.com/openai/v1        AI_MODEL=llama-3.2-11b-vision-preview
#   OpenRouter   AI_BASE_URL=https://openrouter.ai/api/v1               AI_MODEL=google/gemini-2.0-flash-001
#   Gemini compat AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=60000
AI_MAX_TOKENS=900
# Max decoded image size accepted from the client (~4 MB)
AI_MAX_IMAGE_BYTES=4000000
# Per-IP budget: 20 analyses per 10 minutes
AI_RATE_LIMIT=20
AI_RATE_WINDOW_MS=600000
