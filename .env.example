# Frontend env. These values are PUBLIC — they are bundled into the browser
# build, so never put a secret key here.
#
# The crop disease AI key lives in server/.env (AI_API_KEY) so it is never
# shipped to the browser. Start the API with `npm run server`, then the scan
# page posts photos to /api/ai/analyze (proxied to localhost:4000 by Vite).

# Where the SPA sends leaf photos for AI analysis (leave blank for same-origin /api)
VITE_API_BASE_URL=

# Weather service (Open-Meteo, no key required)
VITE_WEATHER_API_URL=https://api.open-meteo.com/v1/forecast

# Your farm's location (lat,lon) used by advisory + irrigation AI
VITE_FARM_LAT=20.435
VITE_FARM_LON=77.091

# Longest edge (px) the photo is downscaled to before upload
VITE_AI_MAX_EDGE=1024
# JPEG quality used for that downscale (0.5 - 1)
VITE_AI_IMAGE_QUALITY=0.82

# Real-time farm IoT sensor feed
VITE_SENSOR_API_URL=https://your-iot-gateway.example.com/feed
